{
  "name": "raw-motion",
  "version": "0.1.0",
  "description": "Raw Motion - an AI platform for generating motion graphics and product launch videos",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-warnings concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development NODE_OPTIONS=--no-warnings electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "logo": "node scripts/generate-logo.mjs",
    "icons": "npm run logo && node scripts/generate-icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "release": "npm run icons && npm run build && electron-builder --win nsis portable",
    "release:installer": "npm run icons && npm run build && electron-builder --win nsis",
    "release:portable": "npm run icons && npm run build && electron-builder --win portable",
    "dist": "npm run release",
    "reset": "git reset --hard",
    "typecheck": "tsc --noEmit",
    "mcp": "node src/mcp/server.js"
  },
  "repository": "https://github.com/nettanvirdev/rawmotion",
  "keywords": [
    "raw-motion",
    "ai",
    "motion-graphics",
    "video",
    "electron",
    "react",
    "vite",
    "tailwindcss",
    "desktop"
  ],
  "author": "Tanvir Ahmed <contact@nettanvir.dev> (https://github.com/nettanvirdev)",
  "license": "CC0-1.0",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remotion/bundler": "^4.0.512",
    "@remotion/media-utils": "^4.0.512",
    "@remotion/noise": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "@remotion/shapes": "^4.0.512",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.512",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.nettanvir.rawmotion",
    "productName": "Raw Motion",
    "copyright": "Copyright © 2026 Tanvir Ahmed",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "src/motion/**/*",
      "src/remotion/**/*",
      "src/mcp/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@remotion/compositor-*/**",
      "node_modules/@remotion/renderer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "Raw Motion",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "Raw Motion ${version}"
    }
  },
  "bin": {
    "rawmotion-mcp": "src/mcp/server.js"
  }
}
